  "shadow": {
    "light": { "$type": "shadow", "$value": "0 1px 2px rgba(14,17,22,.06), 0 8px 24px rgba(14,17,22,.06)" },
    "dark": { "$type": "shadow", "$value": "0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.35)" }
